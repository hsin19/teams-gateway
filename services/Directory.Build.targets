<Project>

  <!--
    SDK 10.0 的 multi-RID container publish 把 label、環境變數以 `名稱:值` 傳給各 RID 的 inner build，再用 Split(':')[1] 拆回來，
    值裡有 `:` 的就只剩第一段：org.opencontainers.image.source 變成 `https`，GHCR 就連不到 repo；建立時間、base image 名稱也一樣。
    這裡照第一個 `:` 重拆一次。label 的部分 upstream 修了（dotnet/sdk#55414），用的 SDK 帶了修正、環境變數也修了就可以拿掉。
  -->
  <Target Name="_ReparseMultiRidContainerItems" AfterTargets="_ParseItemsForPublishingSingleContainer">
    <ItemGroup Condition="@(_ParsedContainerLabel->Count()) > 0">
      <ContainerLabel Remove="@(ContainerLabel)" />
      <ContainerLabel
        Include="$([System.String]::Copy('%(_ParsedContainerLabel.Identity)').Split(':', 2)[0])"
        Value="$([System.String]::Copy('%(_ParsedContainerLabel.Identity)').Split(':', 2)[1])" />
    </ItemGroup>
    <ItemGroup Condition="@(_ParsedContainerEnvironmentVariables->Count()) > 0">
      <ContainerEnvironmentVariables Remove="@(ContainerEnvironmentVariables)" />
      <ContainerEnvironmentVariables
        Include="$([System.String]::Copy('%(_ParsedContainerEnvironmentVariables.Identity)').Split(':', 2)[0])"
        Value="$([System.String]::Copy('%(_ParsedContainerEnvironmentVariables.Identity)').Split(':', 2)[1])" />
    </ItemGroup>
  </Target>

</Project>
