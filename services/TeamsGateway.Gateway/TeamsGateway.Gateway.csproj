<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>teams-gateway</UserSecretsId>
    <!-- 低流量的常駐服務：workstation GC + 非並行，記憶體佔用遠低於預設的 server GC -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="TeamsGateway.Gateway.UnitTests" />
    <InternalsVisibleTo Include="TeamsGateway.Gateway.FunctionalTests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\TeamsGateway.ServiceDefaults\TeamsGateway.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\packages\TeamsGateway.Contracts\TeamsGateway.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>

</Project>
