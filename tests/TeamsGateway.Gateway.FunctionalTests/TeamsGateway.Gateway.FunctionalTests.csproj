<!-- Aspire SDK：GATEWAY_TEST_DB=postgres 時用 Aspire 起 Postgres container 跑同一組測試（照 eShop 的 functional test） -->
<Project Sdk="Aspire.AppHost.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <!-- xunit v3 的測試專案要是可執行檔 -->
    <OutputType>Exe</OutputType>
    <!-- DCP 從 NuGet 拉（不走 Aspire CLI bundle）：跑 Postgres 版測試只要有 Docker，CI 不用另外裝 Aspire CLI -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <!-- ASPIRE010：沒用 CLI bundle 時「有些功能要 bundle」的提醒；測試只拿來起 Postgres container，用不到那些 -->
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="xunit.runner.visualstudio" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\services\TeamsGateway.Gateway\TeamsGateway.Gateway.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

</Project>
